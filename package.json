{
  "name": "arstoien-boilerplate",
  "version": "1.0.0",
  "description": "Production-ready boilerplate for full-stack applications",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "concurrently -n server,client,admin -c cyan,magenta,yellow \"pnpm --filter @blrplt/server dev\" \"pnpm --filter @blrplt/client dev\" \"pnpm --filter @blrplt/admin dev\"",
    "build": "pnpm -r run build",
    "test": "pnpm run test:scripts && pnpm -r run test",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "check": "biome check",
    "check:fix": "biome check --write",
    "ci": "biome ci --error-on-warnings",
    "format": "biome format --write",
    "lint": "biome lint",
    "typecheck": "pnpm -r run typecheck && tsc --project scripts/tsconfig.json",
    "test:integration": "pnpm --filter @blrplt/server run test:integration",
    "spec:validate": "pnpm dlx @fission-ai/openspec@1.14.3 validate --all --strict",
    "spec:check": "node scripts/spec-scenarios.ts check",
    "spec:generate": "node scripts/spec-scenarios.ts generate",
    "db:generate": "pnpm --filter @blrplt/server db:generate",
    "db:migrate": "pnpm --filter @blrplt/server db:migrate",
    "db:push": "pnpm --filter @blrplt/server db:push",
    "db:seed": "pnpm --filter @blrplt/server db:seed",
    "db:studio": "pnpm --filter @blrplt/server db:studio",
    "codegen": "pnpm -r run codegen",
    "i18n": "pnpm -r run i18n"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "catalog:",
    "concurrently": "^10.0.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
