{
  "name": "@blrplt/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm codegen",
    "build": "tsc && vite build",
    "generate:routes": "vite build --mode development --outDir temp-route-gen && rm -rf temp-route-gen",
    "preview": "vite preview",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci --error-on-warnings .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "i18n": "i18next -c i18next-parser.config.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@apollo/client": "^4.3.4",
    "@blrplt/ui": "workspace:*",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-router": "^1.170.45",
    "apollo-upload-client": "^20.0.0",
    "graphql": "16",
    "graphql-ws": "^6.4.1",
    "i18next": "^26.5.2",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.1.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "catalog:",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@parcel/watcher": "^2.6.0",
    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/apollo-upload-client": "^19.0.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "autoprefixer": "^10.6.1",
    "i18next-parser": "^9.4.0",
    "jsdom": "catalog:",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
