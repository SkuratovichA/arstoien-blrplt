{
  "name": "@blrplt/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React components for the client and admin apps",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci --error-on-warnings .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
