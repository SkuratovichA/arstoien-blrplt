{
  "name": "@blrplt/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "prisma generate && rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "pnpm build && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci --error-on-warnings .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "prisma generate && vitest run",
    "test:watch": "prisma generate && vitest",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.ts",
    "test:cov": "prisma generate && vitest run --coverage",
    "typecheck": "prisma generate && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "create:admin": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "create:test-users": "tsx --env-file-if-exists=.env src/scripts/create-test-users.ts",
    "test:email": "tsx --env-file-if-exists=.env scripts/test-email.ts",
    "test:email-service": "tsx --env-file-if-exists=.env scripts/test-email-service.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sesamecare-oss/redlock": "^1.4.0",
    "@types/express-session": "^1.19.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "effect": "^4.0.5",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "graphql": "16",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-upload-ts": "^2.2.0",
    "handlebars": "^4.7.10",
    "image-size": "^2.0.4",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.1.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
