{
  "name": "@blrplt/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "prisma generate && rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "pnpm build && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci --error-on-warnings .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "prisma generate && vitest run",
    "test:watch": "prisma generate && vitest",
    "test:cov": "prisma generate && vitest run --coverage",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "create:admin": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "create:test-users": "tsx --env-file-if-exists=.env src/scripts/create-test-users.ts",
    "test:email": "tsx scripts/test-email.ts",
    "test:email-service": "tsx scripts/test-email-service.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sesamecare-oss/redlock": "^1.4.0",
    "@types/express-session": "^1.18.2",
    "@types/image-size": "^0.8.0",
    "@types/speakeasy": "^2.0.10",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.2",
    "effect": "^4.0.5",
    "express": "^5.3.0",
    "express-session": "^1.18.2",
    "graphql": "^16.11.0",
    "graphql-redis-subscriptions": "^2.6.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-upload-ts": "^2.1.3",
    "handlebars": "^4.7.10",
    "hbs": "^4.2.0",
    "image-size": "^2.0.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.8",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "speakeasy": "^2.0.0",
    "ts-pattern": "^5.0.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/hbs": "^4.0.4",
    "@types/node": "catalog:",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "@vitest/coverage-v8": "catalog:",
    "supertest": "^7.3.1",
    "tsx": "^4.7.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
