    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4",
    "@types/graphql-upload": "^17.0.0",
    "@types/hbs": "^4.0.4",
    "@types/jest": "^29.5.11",
    "@types/node": "catalog:",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "prisma": "^6.18.0",
