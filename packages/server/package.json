{
  "name": "@blrplt/server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "pnpm build && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci --error-on-warnings .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./jest-e2e.config.js --runInBand",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "create:admin": "tsx src/scripts/create-admin.ts",
    "create:test-users": "tsx src/scripts/create-test-users.ts",
    "test:email": "tsx scripts/test-email.ts",
    "test:email-service": "tsx scripts/test-email-service.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@effect/schema": "^0.75.5",
    "@nestjs/apollo": "^12.0.11",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/graphql": "^12.0.11",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/throttler": "^5.1.1",
    "@prisma/client": "^6.18.0",
    "@sesamecare-oss/redlock": "^1.4.0",
    "@types/express-session": "^1.18.2",
    "@types/image-size": "^0.8.0",
    "@types/speakeasy": "^2.0.10",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.2",
    "effect": "^3.18.4",
    "express": "^4.17.1",
    "express-session": "^1.18.2",
    "graphql": "^16.8.1",
    "graphql-redis-subscriptions": "^2.6.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-upload": "^16.0.2",
    "graphql-upload-ts": "^2.1.3",
    "graphql-ws": "^5.14.3",
    "handlebars": "^4.7.10",
    "hbs": "^4.2.0",
    "image-size": "^2.0.2",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-prisma": "^0.23.0",
    "nodemailer": "^6.9.8",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.1",
